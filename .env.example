# Copy this file to .env to change settings (optional)
# Which local model Z.O.E should use. Must be downloaded with 'ollama pull'.
# Recommended ultra-fast models: gemma3:270m, smollm2:360m, llama3.2:1b, phi4-mini
ZOE_MODEL=gemma3:270m

# Note: Z.O.E runs 100% locally on your GPU via Ollama!
# ZERO cloud API keys (like OpenAI/Anthropic) are required. Everything is private.
